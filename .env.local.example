# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase -------------------------------------------------------------
# Project settings -> API. The URL and anon key are public (NEXT_PUBLIC_ is
# inlined into the browser bundle); the anon key is safe there because RLS
# constrains what it can read.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses RLS entirely. Server-only — it must never appear in a NEXT_PUBLIC_
# variable or be imported from a client component. All writes use this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic ------------------------------------------------------------
# Used by lib/generator.ts. Server-only.
ANTHROPIC_API_KEY=sk-ant-...
